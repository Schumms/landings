---
import type { LandingPageData, SectionLayout } from "@lib/types";

interface Props {
  page: LandingPageData;
  layout?: SectionLayout;
}

const { page, layout } = Astro.props;

// Section nur rendern, wenn Headline + Bild gesetzt sind.
if (!page.feature_image_heading || !page.feature_image_image) {
  return null;
}

// Layout-Variante: Text links (default) oder Bild links.
const variant = page.feature_image_layout ?? "text-left-image-right";
const orderClass =
  variant === "image-left-text-right" ? "feature-image__grid--reverse" : "feature-image__grid";

const sectionClasses = [
  "feature-image",
  "section",
  layout?.align && `section--align-${layout.align}`,
  layout?.width && `section--width-${layout.width}`,
  layout?.background && `section--bg-${layout.background}`,
  layout?.text_align && `section--text-align-${layout.text_align}`,
].filter(Boolean);
---

<section class:list={sectionClasses} id="feature-image" aria-labelledby="feature-image-heading">
  <div class:list={["container", "split", orderClass]}>
    <div class="feature-image__copy">
      {page.feature_image_eyebrow && (
        <p class="feature-image__eyebrow">{page.feature_image_eyebrow}</p>
      )}
      <h2 id="feature-image-heading" class="feature-image__heading">
        {page.feature_image_heading}
      </h2>
      {page.feature_image_intro && <p class="feature-image__intro">{page.feature_image_intro}</p>}
      {page.feature_image_text && <p class="feature-image__text">{page.feature_image_text}</p>}
    </div>

    <img
      class="feature-image__visual"
      src={page.feature_image_image}
      alt={page.feature_image_image_alt ?? page.feature_image_heading}
      loading="lazy"
    />
  </div>
</section>

<style>
  .feature-image__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold, 600);
    letter-spacing: var(--tracking-wide, 0.08em);
    text-transform: uppercase;
    color: var(--color-coral);
    margin-bottom: 1rem;
    max-width: none;
  }

  .feature-image__heading {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-weight: var(--font-weight-bold, 700);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight, -0.03em);
    margin: 0 0 1.25rem;
    max-width: 16ch;
  }

  .feature-image__intro {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  .feature-image__text {
    margin-top: 1rem;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  .feature-image__visual {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Variante: Bild links, Text rechts — nur Grid-Order umkehren. */
  .feature-image__grid--reverse {
    direction: rtl;
  }

  .feature-image__grid--reverse > * {
    direction: ltr;
  }

  @media (max-width: 800px) {
    .feature-image__grid--reverse {
      direction: ltr;
    }
  }
</style>
