---
import type { LandingPageData, SectionLayout } from "@lib/types";

interface Props {
  page: LandingPageData;
  layout?: SectionLayout;
}

const { page, layout } = Astro.props;

const sectionClasses = [
  "comparison",
  "section",
  layout?.align && `section--align-${layout.align}`,
  layout?.width && `section--width-${layout.width}`,
  layout?.background && `section--bg-${layout.background}`,
  layout?.text_align && `section--text-align-${layout.text_align}`,
].filter(Boolean);

// Section nur rendern, wenn Rows vorhanden sind.
if (!page.comparison?.length) {
  return null;
}

const labelA = page.comparison_label_a ?? "Variante A";
const labelB = page.comparison_label_b ?? "Variante B";
const highlight = page.comparison_highlight ?? null;
---

<section class:list={sectionClasses} id="comparison" aria-labelledby="comparison-heading">
  <div class="container">
    {(page.comparison_heading || page.comparison_intro) && (
      <header class="comparison__header">
        {page.comparison_heading && <h2 id="comparison-heading">{page.comparison_heading}</h2>}
        {page.comparison_intro && <p class="comparison__intro">{page.comparison_intro}</p>}
      </header>
    )}

    <div class="comparison__table-wrap">
      <table class="comparison__table">
        <thead>
          <tr>
            <th class="comparison__feature-head" scope="col"><span class="sr-only">Kriterium</span></th>
            <th
              class:list={[
                "comparison__col-head",
                highlight === "a" && "comparison__col-head--highlight",
              ]}
              scope="col"
            >{labelA}</th>
            <th
              class:list={[
                "comparison__col-head",
                highlight === "b" && "comparison__col-head--highlight",
              ]}
              scope="col"
            >{labelB}</th>
          </tr>
        </thead>
        <tbody>
          {page.comparison.map((row) => (
            <tr>
              <th class="comparison__feature" scope="row">{row.feature}</th>
              <td
                class:list={[
                  "comparison__cell",
                  highlight === "a" && "comparison__cell--highlight",
                ]}
              >{row.value_a}</td>
              <td
                class:list={[
                  "comparison__cell",
                  highlight === "b" && "comparison__cell--highlight",
                ]}
              >{row.value_b}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison__header {
    margin-bottom: 3rem;
    max-width: 48rem;
  }

  .comparison__intro {
    margin-top: 1rem;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .comparison__table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .comparison__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .comparison__table th,
  .comparison__table td {
    text-align: left;
    padding: 1.1rem 1.25rem;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line, var(--color-border, #e2e2e2));
  }

  .comparison__col-head {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold, 600);
    letter-spacing: var(--tracking-wide, 0.08em);
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: transparent;
  }

  .comparison__col-head--highlight {
    color: var(--color-coral);
  }

  .comparison__feature {
    font-weight: var(--font-weight-semibold, 600);
    width: 32%;
    color: var(--color-black);
  }

  .comparison__feature-head {
    width: 32%;
  }

  .comparison__cell {
    color: var(--color-text-muted);
    width: 34%;
  }

  .comparison__cell--highlight {
    background: rgba(253, 120, 87, 0.06);
    color: var(--color-black);
    font-weight: var(--font-weight-semibold, 600);
  }

  @media (max-width: 640px) {
    .comparison__feature,
    .comparison__feature-head {
      width: 40%;
    }

    .comparison__cell {
      width: 30%;
    }

    .comparison__table th,
    .comparison__table td {
      padding: 0.85rem 0.75rem;
      font-size: var(--text-sm);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
