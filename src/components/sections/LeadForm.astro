---
import type { LandingPageData, SectionLayout } from "@lib/types";
import brand from "@data/brand";

interface Props {
  page: LandingPageData;
  layout?: SectionLayout;
}

const { page, layout } = Astro.props;

const sectionClasses = [
  "form",
  "section",
  "section--coral",
  layout?.align && `section--align-${layout.align}`,
  layout?.width && `section--width-${layout.width}`,
  layout?.background && `section--bg-${layout.background}`,
  layout?.text_align && `section--text-align-${layout.text_align}`,
].filter(Boolean);

const hasHubSpot = !!page.hubspot_portal_id && !!page.hubspot_form_id;
const hasWebhook = !!page.form_webhook;

const privacyNote =
  page.form_privacy_note ??
  "Ich willige ein, dass meine Angaben zur Beantwortung meiner Anfrage elektronisch erhoben und verarbeitet werden.";

const formIntro = page.form_intro ?? "Schnell ausgefüllt — wir melden uns umgehend.";

// Optionale Felder — jede Page schaltet sie via Frontmatter ein.
// Defaults: alle aus, damit bestehende Pages unverändert rendern.
const showSalutation = page.form_show_salutation ?? false;
const showPhone = page.form_show_phone ?? false;
const showEmployeeCount = page.form_show_employee_count ?? false;
const showMessage = page.form_show_message ?? false;

// Wenn Anrede aktiv → firstname/lastname getrennt rendern
const splitName = showSalutation || page.form_split_name === true;

const salutationOptions: readonly string[] =
  page.form_salutation_options ?? ["Frau", "Herr", "Divers", "Keine Angabe"];

const employeeCountOptions: readonly string[] =
  page.form_employee_count_options ?? ["25-50", "51-200", "201-500", "500+"];

const messageLabel = page.form_message_label ?? "Dein Anlass";
const messageMaxLength = page.form_message_max_length ?? 300;
---

<section class:list={sectionClasses} id="lead-form" aria-labelledby="form-heading">
  <div class="container split">
    <div class="lead-form__intro">
      <h2 id="form-heading">{page.form_title}</h2>
      <p class="lead-form__hint">{formIntro}</p>
    </div>

    <form
      class="lead-form__form"
      id="landing-form"
      data-hubspot-portal={page.hubspot_portal_id ?? ""}
      data-hubspot-form={page.hubspot_form_id ?? ""}
      data-webhook={page.form_webhook ?? ""}
      data-download={page.form_download_url ?? ""}
      data-success={page.form_success_message ?? "Vielen Dank für deine Anfrage!"}
      data-split-name={splitName ? "true" : "false"}
    >
      {showSalutation && (
        <div class="form-field">
          <label class="sr-only" for="salutation">Anrede</label>
          <select id="salutation" name="salutation" required>
            <option value="" disabled selected>Anrede</option>
            {salutationOptions.map((opt) => (
              <option value={opt}>{opt}</option>
            ))}
          </select>
        </div>
      )}

      {splitName ? (
        <div class="form-field form-field--row">
          <div>
            <label class="sr-only" for="firstname">Vorname</label>
            <input id="firstname" name="firstname" type="text" placeholder="Vorname" autocomplete="given-name" required />
          </div>
          <div>
            <label class="sr-only" for="lastname">Nachname</label>
            <input id="lastname" name="lastname" type="text" placeholder="Nachname" autocomplete="family-name" required />
          </div>
        </div>
      ) : (
        <div class="form-field">
          <label class="sr-only" for="name">Name</label>
          <input id="name" name="name" type="text" placeholder="Name" autocomplete="name" required />
        </div>
      )}

      <div class="form-field">
        <label class="sr-only" for="email">E-Mail-Adresse</label>
        <input id="email" name="email" type="email" placeholder="E-Mail" autocomplete="email" required />
      </div>

      {showPhone && (
        <div class="form-field">
          <label class="sr-only" for="phone">Telefonnummer</label>
          <input id="phone" name="phone" type="tel" placeholder="Telefonnummer" autocomplete="tel" required />
        </div>
      )}

      <div class="form-field">
        <label class="sr-only" for="company">Firma</label>
        <input id="company" name="company" type="text" placeholder="Firma" autocomplete="organization" required />
      </div>

      {showEmployeeCount && (
        <div class="form-field">
          <label class="sr-only" for="employee_count">Mitarbeiterzahl</label>
          <select id="employee_count" name="employee_count" required>
            <option value="" disabled selected>Mitarbeiterzahl</option>
            {employeeCountOptions.map((opt) => (
              <option value={opt}>{opt}</option>
            ))}
          </select>
        </div>
      )}

      {showMessage && (
        <div class="form-field">
          <label class="sr-only" for="message">{messageLabel}</label>
          <textarea
            id="message"
            name="message"
            placeholder={messageLabel}
            maxlength={messageMaxLength}
            rows="4"
          ></textarea>
          <small class="form-field__counter" data-counter-for="message">
            <span data-counter-used>0</span> / {messageMaxLength}
          </small>
        </div>
      )}

      <div class="form-field form-field--checkbox">
        <label class="checkbox-label">
          <input type="checkbox" name="privacy" required />
          <span>
            {privacyNote}
            <a href={brand.legal.datenschutz}>Datenschutzerklärung</a>
          </span>
        </label>
      </div>

      <button class="btn btn--block lead-form__submit" type="submit">
        {page.form_cta}
      </button>

      <p class="lead-form__note">Kein Spam. <a href={brand.legal.datenschutz}>Datenschutzerklärung</a>.</p>
      <p class="lead-form__status" id="form-status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<style>
  .lead-form__hint {
    margin-top: 1rem;
    font-size: var(--text-lg);
    line-height: 1.55;
    max-width: 38ch;
  }

  .lead-form__form {
    display: grid;
    gap: 0.875rem;
  }

  .form-field--row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 540px) {
    .form-field--row {
      grid-template-columns: 1fr;
    }
  }

  .form-field textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-border, #e2e2e2);
    border-radius: 0;
    font: inherit;
    font-size: var(--text-base);
    line-height: 1.5;
    background: var(--color-white);
    color: var(--color-black);
    resize: vertical;
    min-height: 5.5rem;
    box-sizing: border-box;
  }

  .form-field textarea:focus {
    outline: 2px solid var(--color-coral);
    outline-offset: -2px;
  }

  .form-field select {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-border, #e2e2e2);
    border-radius: 0;
    font: inherit;
    font-size: var(--text-base);
    background: var(--color-white);
    color: var(--color-black);
    box-sizing: border-box;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-muted) 50%),
      linear-gradient(135deg, var(--color-muted) 50%, transparent 50%);
    background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }

  .form-field select:focus {
    outline: 2px solid var(--color-coral);
    outline-offset: -2px;
  }

  .form-field__counter {
    display: block;
    text-align: right;
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  .form-field--checkbox .checkbox-label {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: var(--text-sm);
    line-height: 1.5;
    cursor: pointer;
  }

  .form-field--checkbox input {
    margin-top: 0.2rem;
    width: auto;
    flex-shrink: 0;
  }

  .form-field--checkbox a,
  .lead-form__note a {
    text-decoration: underline;
  }

  .lead-form__note {
    font-size: var(--text-xs);
    max-width: none;
    opacity: 0.85;
  }

  .lead-form__status {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    max-width: none;
  }

  .lead-form__status[data-state="error"] {
    color: #8b0000;
  }
</style>

<script>
  const form = document.getElementById("landing-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  // Live-Character-Counter für Textarea(s) im Formular
  document.querySelectorAll<HTMLTextAreaElement>(".lead-form__form textarea[maxlength]").forEach((ta) => {
    const counterWrap = ta.parentElement?.querySelector<HTMLElement>("[data-counter-for]");
    const used = counterWrap?.querySelector<HTMLElement>("[data-counter-used]");
    const update = () => {
      if (used) used.textContent = String(ta.value.length);
    };
    ta.addEventListener("input", update);
    update();
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !status) return;

    const hubspotPortal = form.dataset.hubspotPortal;
    const hubspotForm = form.dataset.hubspotForm;
    const webhook = form.dataset.webhook;
    const downloadUrl = form.dataset.download;
    const successMessage = form.dataset.success ?? "Vielen Dank!";
    const splitName = form.dataset.splitName === "true";
    const submitBtn = form.querySelector<HTMLButtonElement>(".lead-form__submit");

    submitBtn?.setAttribute("disabled", "true");
    status.hidden = false;
    status.dataset.state = "";
    status.textContent = "Wird gesendet …";

    const formData = new FormData(form);

    // Name-Logik: bei splitName direkt firstname/lastname,
    // sonst kombiniertes "name"-Feld am letzten Leerzeichen splitten.
    let firstname = "";
    let lastname = "-";
    if (splitName) {
      firstname = String(formData.get("firstname") ?? "").trim();
      lastname = String(formData.get("lastname") ?? "").trim() || "-";
    } else {
      const nameRaw = String(formData.get("name") ?? "").trim();
      firstname = nameRaw;
      const lastSpace = nameRaw.lastIndexOf(" ");
      if (lastSpace > 0) {
        firstname = nameRaw.slice(0, lastSpace).trim();
        lastname = nameRaw.slice(lastSpace + 1).trim();
      }
    }

    const email = String(formData.get("email") ?? "").trim();
    const company = String(formData.get("company") ?? "").trim();
    const salutation = String(formData.get("salutation") ?? "").trim();
    const phone = String(formData.get("phone") ?? "").trim();
    const employeeCount = String(formData.get("employee_count") ?? "").trim();
    const message = String(formData.get("message") ?? "").trim();

    try {
      if (hubspotPortal && hubspotForm) {
        // ── HubSpot Forms API (HubSpot-first) ──
        // Property-Namen entsprechen HubSpot-Built-ins (salutation, firstname,
        // lastname, email, phone, company) plus optionale Custom-Properties
        // (employee_count, message). Timo legt diese in HubSpot an.
        const fields: any[] = [
          { name: "firstname", value: firstname },
          { name: "lastname", value: lastname },
          { name: "email", value: email },
        ];

        if (salutation) fields.push({ name: "salutation", value: salutation });
        if (phone) fields.push({ name: "phone", value: phone });
        if (company) fields.push({ name: "company", value: company });
        if (employeeCount) fields.push({ name: "employee_count", value: employeeCount });
        if (message) fields.push({ name: "message", value: message });

        const payload = {
          fields,
          context: {
            pageUri: window.location.href,
            pageName: document.title,
          },
        };

        const response = await fetch(
          `https://api.hsforms.com/submissions/v3/integration/submit/${hubspotPortal}/${hubspotForm}`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          }
        );

        // HubSpot gibt auch 200 zurück mit Fehlern im Body
        const rawBody = await response.text();
        let body: any = {};
        try { body = JSON.parse(rawBody); } catch { /* kein JSON */ }

        if (!response.ok) {
          console.error("HubSpot HTTP Error:", response.status, body);
          const msg = body.message ?? body.errors?.[0]?.message ?? `HTTP ${response.status}`;
          throw new Error(`HubSpot: ${msg}`);
        }

        // Auch bei 200: Prüfe auf HubSpot-Validierungsfehler
        if (body.errors && body.errors.length > 0) {
          console.error("HubSpot Validation Errors:", body.errors);
          throw new Error(`HubSpot: ${body.errors[0].message}`);
        }
      } else if (webhook) {
        // ── Fallback: generischer Webhook ──
        const data = Object.fromEntries(formData.entries());
        const response = await fetch(webhook, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (!response.ok) throw new Error("Webhook request failed");
      } else {
        throw new Error("Kein Formular-Ziel konfiguriert.");
      }

      status.textContent = successMessage;
      form.reset();
      // Counter nach Reset auf 0 setzen
      document.querySelectorAll<HTMLTextAreaElement>(".lead-form__form textarea[maxlength]").forEach((ta) => {
        const counterWrap = ta.parentElement?.querySelector<HTMLElement>("[data-counter-for]");
        const used = counterWrap?.querySelector<HTMLElement>("[data-counter-used]");
        if (used) used.textContent = "0";
      });

      if (downloadUrl) {
        window.setTimeout(() => {
          window.open(downloadUrl, "_blank", "noopener,noreferrer");
        }, 600);
      }
    } catch (err: any) {
      status.dataset.state = "error";
      // Vollständigen Fehler anzeigen, damit der User beim nächsten Test genau weiß, was passiert
      status.textContent = err.message ?? "Etwas ist schiefgelaufen. Bitte versuche es erneut.";
      console.error("Form submission error:", err);
    } finally {
      submitBtn?.removeAttribute("disabled");
    }
  });
</script>
