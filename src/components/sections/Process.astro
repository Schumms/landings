---
import type { LandingPageData, SectionLayout } from "@lib/types";

interface Props {
  page: LandingPageData;
  layout?: SectionLayout;
}

const { page, layout } = Astro.props;

const sectionClasses = [
  "process",
  "section",
  layout?.align && `section--align-${layout.align}`,
  layout?.width && `section--width-${layout.width}`,
  layout?.background && `section--bg-${layout.background}`,
  layout?.text_align && `section--text-align-${layout.text_align}`,
].filter(Boolean);

if (!page.process_steps?.length) {
  return null;
}
---

<section class:list={sectionClasses} id="process" aria-labelledby="process-heading">
  <div class="container split split--40-60">
    <div>
      <h2 id="process-heading">
        {page.process_heading ?? "So funktioniert's"}
        {page.process_heading_accent && (
          <> <span class="text-accent">{page.process_heading_accent}</span></>
        )}
      </h2>
    </div>

    <ol class="divider-list">
      {
        page.process_steps.map((step, index) => (
          <li class="divider-list__item">
            <span class="number-badge" aria-hidden="true">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process h3 {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    margin-bottom: 0.35rem;
  }

  .process .text-accent {
    color: var(--color-coral);
  }

  .process p {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    max-width: none;
  }
</style>
