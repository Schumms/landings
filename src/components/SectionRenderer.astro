---
import type { LandingPageData } from "@lib/types";
import type { ContentSectionId } from "@lib/sections";
import Hero from "@components/sections/Hero.astro";
import SocialProofBar from "@components/sections/SocialProofBar.astro";
import Problem from "@components/sections/Problem.astro";
import Pricing from "@components/sections/Pricing.astro";
import Program from "@components/sections/Program.astro";
import Transformation from "@components/sections/Transformation.astro";
import Benefits from "@components/sections/Benefits.astro";
import Process from "@components/sections/Process.astro";
import Speakers from "@components/sections/Speakers.astro";
import Testimonial from "@components/sections/Testimonial.astro";
import About from "@components/sections/About.astro";
import ContentPreview from "@components/sections/ContentPreview.astro";
import Location from "@components/sections/Location.astro";
import FAQ from "@components/sections/FAQ.astro";
import LeadForm from "@components/sections/LeadForm.astro";
import ContactForm from "@components/sections/ContactForm.astro";
import SecondaryCTA from "@components/sections/SecondaryCTA.astro";

interface Props {
  page: LandingPageData;
  sections: ContentSectionId[];
}

const { page, sections } = Astro.props;

/**
 * Resolve layout override for a given section id.
 * Returns undefined if no override is configured — components keep their default classes.
 */
const layoutFor = (id: string) => page.sections_layout?.[id];
---

{
  sections.map((id) => {
    switch (id) {
      case "hero":
        return <Hero page={page} layout={layoutFor("hero")} />;
      case "social_proof_bar":
        return <SocialProofBar page={page} layout={layoutFor("social_proof_bar")} />;
      case "problem":
        return <Problem page={page} layout={layoutFor("problem")} />;
      case "pricing":
        return <Pricing page={page} layout={layoutFor("pricing")} />;
      case "program":
        return <Program page={page} layout={layoutFor("program")} />;
      case "transformation":
        return <Transformation page={page} layout={layoutFor("transformation")} />;
      case "benefits":
        return <Benefits page={page} layout={layoutFor("benefits")} />;
      case "process":
        return <Process page={page} layout={layoutFor("process")} />;
      case "speakers":
        return <Speakers page={page} layout={layoutFor("speakers")} />;
      case "testimonial":
        return <Testimonial page={page} layout={layoutFor("testimonial")} />;
      case "about":
        return <About page={page} layout={layoutFor("about")} />;
      case "content_preview":
        return <ContentPreview page={page} layout={layoutFor("content_preview")} />;
      case "location":
        return <Location page={page} layout={layoutFor("location")} />;
      case "faq":
        return <FAQ page={page} layout={layoutFor("faq")} />;
      case "form":
        return <LeadForm page={page} layout={layoutFor("form")} />;
      case "contact_form":
        return <ContactForm page={page} layout={layoutFor("contact_form")} />;
      case "secondary_cta":
        return <SecondaryCTA page={page} layout={layoutFor("secondary_cta")} />;
      default:
        return null;
    }
  })
}
