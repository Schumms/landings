---
import type { LandingPageData, SectionLayout } from "@lib/types";

interface Props {
  page: LandingPageData;
  layout?: SectionLayout;
}

const { page, layout } = Astro.props;

const sectionClasses = [
  "service-overview",
  "section",
  layout?.align && `section--align-${layout.align}`,
  layout?.width && `section--width-${layout.width}`,
  layout?.background && `section--bg-${layout.background}`,
  layout?.text_align && `section--text-align-${layout.text_align}`,
].filter(Boolean);

// Section nur rendern, wenn Cards vorhanden sind — sonst leerer Container.
if (!page.service_overview?.length) {
  return null;
}
---

<section class:list={sectionClasses} id="service-overview" aria-labelledby="service-overview-heading">
  <div class="container">
    {page.service_overview_heading && (
      <header class="service-overview__header">
        <h2 id="service-overview-heading">{page.service_overview_heading}</h2>
        {page.service_overview_intro && (
          <p class="service-overview__intro">{page.service_overview_intro}</p>
        )}
      </header>
    )}

    <ol class="service-overview__grid" role="list">
      {page.service_overview.map((service) => (
        <li class="service-overview__card">
          {service.image && (
            <div class="service-overview__media">
              <img
                src={service.image}
                alt={service.image_alt ?? service.title}
                loading="lazy"
              />
            </div>
          )}

          <div class="service-overview__body">
            {service.eyebrow && (
              <p class="service-overview__eyebrow">{service.eyebrow}</p>
            )}
            <h3 class="service-overview__title">{service.title}</h3>
            <p class="service-overview__description">{service.description}</p>

            {service.bullets?.length && (
              <ul class="service-overview__bullets" role="list">
                {service.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}

            {service.cta_text && service.cta_href && (
              <a class="service-overview__cta" href={service.cta_href}>
                {service.cta_text}
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .service-overview__header {
    margin-bottom: 3rem;
    max-width: 48rem;
  }

  .service-overview__intro {
    margin-top: 1rem;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .service-overview__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 720px) {
    .service-overview__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .service-overview__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-overview__card {
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--color-coral);
    padding-top: 1.75rem;
  }

  .service-overview__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 1.5rem;
    background: var(--color-muted);
  }

  .service-overview__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .service-overview__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide, 0.08em);
    text-transform: uppercase;
    color: var(--color-coral);
    margin-bottom: 0.5rem;
    max-width: none;
  }

  .service-overview__title {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    margin-bottom: 0.75rem;
    max-width: 18ch;
  }

  .service-overview__description {
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: none;
  }

  .service-overview__bullets {
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-overview__bullets li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    max-width: none;
  }

  .service-overview__bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-coral);
    font-weight: var(--font-weight-bold);
  }

  .service-overview__cta {
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide, 0.08em);
    text-transform: uppercase;
    color: var(--color-coral);
    text-decoration: none;
    border-bottom: 1px solid var(--color-coral);
    padding-bottom: 0.2rem;
    width: fit-content;
  }

  .service-overview__cta:hover {
    color: var(--color-coral-dark, #e5623e);
    border-bottom-color: var(--color-coral-dark, #e5623e);
  }
</style>
