---
import { execSync } from "child_process";
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Nav from "@components/global/Nav.astro";
import Footer from "@components/global/Footer.astro";
import brand from "@data/brand";

// Branch erkennen — main = Live (Redirect), dev = Preview (Liste)
let branch = "main";
try {
  branch = execSync("git rev-parse --abbrev-ref HEAD", { cwd: process.cwd() }).toString().trim();
} catch {}

// Auf main: immer Redirect auf schumms.com
if (branch === "main") {
  return Astro.redirect("https://schumms.com", 301);
}

// Auf dev: Liste aller Pages (auch Entwürfe) als Preview-Übersicht
const pages = await getCollection("pages");
const sorted = pages.sort((a, b) => a.data.title.localeCompare(b.data.title, "de"));
---

<BaseLayout
  title="Landingpages — Preview"
  description="Schumm & Rösch — Agent-gestütztes Landing Page System"
  robots="noindex, nofollow"
>
  <Nav minimal />
  <main id="main-content" class="index">
    <div class="container">
      <p class="index__eyebrow">Schumm & Rösch</p>
      <h1>Landingpages — Preview</h1>
      <p class="index__intro">
        Hier siehst du alle Landingpages, die gerade in Arbeit sind.
        Entwürfe sind mit einem Badge markiert.
      </p>

      <ul class="index__list divider-list" role="list">
        {
          sorted.map((entry) => (
            <li class="divider-list__item index__item">
              <div>
                <a class="index__link" href={`/${entry.data.slug}/`}>
                  {entry.data.title}
                </a>
              </div>
              {entry.data.published ? (
                <span class="index__badge index__badge--live">Live</span>
              ) : (
                <span class="index__badge">Entwurf</span>
              )}
            </li>
          ))
        }
      </ul>

      <p class="index__note">
        <a href={brand.url}>schumms.com</a>
      </p>
    </div>
  </main>
  <Footer minimal />
</BaseLayout>

<style>
  .index {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .index__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .index__intro {
    margin-top: 1.25rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    max-width: 50ch;
  }

  .index__list {
    margin-top: 3rem;
    max-width: 40rem;
  }

  .index__item {
    align-items: center;
    justify-content: space-between;
  }

  .index__link {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .index__link:hover {
    text-decoration: underline;
  }

  .index__badge {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .index__badge--live {
    color: var(--color-mint);
  }

  .index__note {
    margin-top: 3rem;
    font-size: var(--text-sm);
    max-width: none;
  }

  .index__note a {
    text-decoration: underline;
  }
</style>