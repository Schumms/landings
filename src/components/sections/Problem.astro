---
import type { LandingPageData, SectionLayout } from "@lib/types";
import PricingCard from "@components/sections/PricingCard.astro";

interface Props {
  page: LandingPageData;
  layout?: SectionLayout;
}

const { page, layout } = Astro.props;

const sectionClasses = [
  "problem",
  "section",
  "section--compact",
  layout?.align && `section--align-${layout.align}`,
  layout?.width && `section--width-${layout.width}`,
  layout?.background && `section--bg-${layout.background}`,
  layout?.text_align && `section--text-align-${layout.text_align}`,
].filter(Boolean);

if (!page.problem_points?.length && !page.problem_intro) {
  return null;
}

const hasPricing = Boolean(page.pricing_amount);
---

<section class:list={[...sectionClasses, page.problem_image && "problem--with-image"]} id="problem" aria-labelledby="problem-heading">
  <div class="container">
    <div class:list={["split", hasPricing && "split--intro-pricing", "problem__layout"]}>
      <div class="problem__intro">
        <h2 id="problem-heading">{page.problem_heading ?? "Kennst du das?"}</h2>
        {page.problem_intro && <p class="problem__intro-text">{page.problem_intro}</p>}
      </div>

      {hasPricing && (
        <aside class="problem__pricing" aria-label="Ticket-Preis">
          <PricingCard page={page} />
        </aside>
      )}

      {!hasPricing && page.problem_image && (
        <figure class="problem__media">
          <img
            src={page.problem_image}
            alt={page.problem_image_alt ?? ""}
            loading="lazy"
          />
        </figure>
      )}
    </div>

    {
      page.problem_points?.length ? (
        <ol class="divider-list problem__list">
          {page.problem_points.map((point, index) => (
            <li class="divider-list__item">
              <span class="number-badge" aria-hidden="true">{index + 1}</span>
              <p>{point}</p>
            </li>
          ))}
        </ol>
      ) : null
    }
  </div>
</section>

<style>
  .problem__intro-text {
    margin-top: 1rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.55;
    max-width: none;
  }

  .problem__pricing {
    width: 100%;
  }

  @media (min-width: 768px) {
    .problem__pricing {
      justify-self: end;
      margin-left: auto;
    }
  }

  @media (max-width: 767px) {
    .problem__pricing {
      display: flex;
      justify-content: center;
    }
  }

  .problem__list {
    margin-top: 2.5rem;
    max-width: 48rem;
  }

  /* Bild neben dem Intro (16:9). Überschreibt das bestehende Split-Layout
     nur, wenn problem_image gesetzt ist und keine Pricing-Card da ist. */
  .problem--with-image .problem__layout {
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .problem__media {
    margin: 0;
  }

  .problem__media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
</style>
