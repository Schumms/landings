---
import type { LandingPageData, SectionLayout } from "@lib/types";

interface Props {
  page: LandingPageData;
  layout?: SectionLayout;
}

const { page, layout } = Astro.props;

const sectionClasses = [
  "references",
  "section",
  layout?.align && `section--align-${layout.align}`,
  layout?.width && `section--width-${layout.width}`,
  layout?.background && `section--bg-${layout.background}`,
  layout?.text_align && `section--text-align-${layout.text_align}`,
].filter(Boolean);

if (!page.references?.length) {
  return null;
}
---

<section class:list={sectionClasses} id="references" aria-labelledby="references-heading">
  <div class="container">
    {page.references_heading && (
      <h2 id="references-heading" class="references__heading">{page.references_heading}</h2>
    )}
    {page.references_intro && <p class="references__intro">{page.references_intro}</p>}

    <div class="references__grid">
      {page.references.map((ref) => (
        <article class="references__card">
          {ref.image && (
            <div class="references__media">
              <img src={ref.image} alt={ref.image_alt ?? ref.industry} loading="lazy" />
            </div>
          )}
          <div class="references__body">
            <p class="references__meta">
              <strong>{ref.industry}</strong>
            </p>
            {ref.size && <p class="references__size">{ref.size}</p>}
            <p class="references__challenge">
              <span class="references__label">Herausforderung</span>
              {ref.challenge}
            </p>
            <p class="references__result">
              <span class="references__label">Ergebnis</span>
              {ref.result}
            </p>
          </div>
        </article>
      ))}
    </div>

    {page.references_closing_quote && (
      <blockquote class="references__quote">
        <p>&ldquo;{page.references_closing_quote}&rdquo;</p>
      </blockquote>
    )}

    {page.references_cta_text && page.references_cta_href && (
      <div class="references__cta">
        <a class="btn btn--coral" href={page.references_cta_href}>{page.references_cta_text}</a>
      </div>
    )}
  </div>
</section>

<style>
  .references__heading {
    max-width: 22ch;
  }

  .references__intro {
    margin-top: 1rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.55;
    max-width: 60ch;
  }

  .references__grid {
    margin-top: 3rem;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .references__grid {
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }
  }

  .references__card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-border, #e2e2e2);
    border-radius: 0;
  }

  .references__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-muted);
  }

  .references__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .references__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .references__meta {
    font-size: var(--text-base);
    max-width: none;
  }

  .references__size {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-regular);
    font-size: var(--text-sm);
    margin-top: -0.35rem;
  }

  .references__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide, 0.08em);
    text-transform: uppercase;
    color: var(--color-coral);
    margin-bottom: 0.4rem;
  }

  .references__challenge,
  .references__result {
    font-size: var(--text-sm);
    line-height: 1.55;
    max-width: none;
  }

  .references__result {
    color: var(--color-text-muted);
  }

  .references__quote {
    margin: 3rem auto 0;
    max-width: 48rem;
    padding: 1.5rem 2rem;
    background: transparent;
    border-left: 3px solid var(--color-coral);
    font-family: var(--font-buenos-aires);
    font-weight: 800;
    font-size: var(--text-xl);
    line-height: 1.3;
    font-style: normal;
    color: var(--color-coral);
  }

  .references__quote p {
    margin: 0;
  }

  .references__cta {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }
</style>
