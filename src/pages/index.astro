---
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "@layouts/BaseLayout.astro";
import Nav from "@components/global/Nav.astro";
import Footer from "@components/global/Footer.astro";
import brand from "@data/brand";

// ── Markdown-Pages aus Content Collection ──
const allPages = await getCollection("pages");
const sorted = allPages.sort((a, b) => a.data.title.localeCompare(b.data.title, "de"));

const published = sorted.filter(p => p.data.published);
const drafts = sorted.filter(p => !p.data.published);

// ── Gebündelte HTML-Pages in public/[slug]/index.html ──
// Manche Landingpages (z.B. HR@WORK) sind als self-contained Bundle direkt
// unter public/ abgelegt — sie umgehen die Content Collection und werden
// unverändert von Astro kopiert. Damit sie im Dashboard erscheinen, scannen
// wir public/ zur Build-Zeit nach [slug]/index.html.
const bundledPaths = Object.keys(import.meta.glob('/public/*/index.html'));

const bundledPages = bundledPaths.map((p) => {
  const slug = p.split('/')[2]; // /public/[slug]/index.html → [slug]

  // Versuche, einen sauberen Titel aus dem <title>-Tag der HTML zu extrahieren.
  // Schema: "<title>HR-Workshop ... · Schumm & Rösch</title>" → "HR-Workshop ..."
  let title = slug
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
  try {
    const html = readFileSync(join(process.cwd(), 'public', slug, 'index.html'), 'utf-8');
    const m = html.match(/<title>([^<]+)<\/title>/);
    if (m) {
      const raw = m[1].trim();
      // Brand-Suffix entfernen: alles ab " · Schumm" / " — Schumm" / " - Schumm"
      title = raw.replace(/\s*[·|—–-]\s*Schumm.*$/i, '').trim() || title;
    }
  } catch {
    // Fallback: Slug als Title
  }
  return { slug, title, isBundle: true };
});

// Duplikate raus: gebündelte Pages, für die es bereits eine veröffentlichte
// Markdown-Page gibt, werden nicht doppelt gelistet.
const markdownSlugs = new Set(published.map((p) => p.data.slug));
const filteredBundled = bundledPages.filter((b) => !markdownSlugs.has(b.slug));

// ── Vereinheitlichte Published-Liste ──
const allPublished = [
  ...published.map((p) => ({
    slug: p.data.slug,
    title: p.data.title,
    isBundle: false,
  })),
  ...filteredBundled,
].sort((a, b) => a.title.localeCompare(b.title, 'de'));
---

<BaseLayout
  title="Landingpages — Preview"
  description="Schumm & Rösch — Landingpage Preview"
  robots="noindex, nofollow"
>
  <Nav minimal />
  <main id="main-content" class="index">
    <div class="container">
      <p class="index__eyebrow">Schumm & Rösch</p>
      <h1>Landingpages — Preview</h1>
      <p class="index__intro">
        Hier siehst du alle Landingpages — auch die, die noch in Arbeit sind.
        Entwürfe sind mit einem Badge markiert.
      </p>

      {allPublished.length > 0 && (
        <>
          <h2 class="index__section-title">Veröffentlicht</h2>
          <ul class="index__list divider-list" role="list">
            {
              allPublished.map((entry) => (
                <li class="divider-list__item index__item">
                  <div>
                    <a class="index__link" href={`/${entry.slug}/`}>
                      {entry.title}
                    </a>
                  </div>
                  <span class="index__badge index__badge--live">Live</span>
                </li>
              ))
            }
          </ul>
        </>
      )}

      {drafts.length > 0 && (
        <div class="index__drafts">
          <h2 class="index__section-title">In Arbeit</h2>
          <ul class="index__list divider-list" role="list">
            {
              drafts.map((entry) => (
                <li class="divider-list__item index__item">
                  <div>
                    <a class="index__link" href={`/${entry.data.slug}/`}>
                      {entry.data.title}
                    </a>
                  </div>
                  <span class="index__badge">Entwurf</span>
                </li>
              ))
            }
          </ul>
        </div>
      )}

      <p class="index__note">
        <a href={brand.url}>Zurück zu schumms.com</a>
      </p>
    </div>
  </main>
  <Footer minimal />
</BaseLayout>

<style>
  .index {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .index__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .index__intro {
    margin-top: 1.25rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    max-width: 50ch;
  }

  .index__section-title {
    margin-top: 3rem;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
  }

  .index__list {
    margin-top: 1.5rem;
    max-width: 40rem;
  }

  .index__item {
    align-items: center;
    justify-content: space-between;
  }

  .index__link {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .index__link:hover {
    text-decoration: underline;
  }

  .index__badge {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .index__badge--live {
    color: var(--color-mint);
  }

  .index__drafts {
    margin-top: 4rem;
    opacity: 0.7;
  }

  .index__note {
    margin-top: 4rem;
    font-size: var(--text-sm);
    max-width: none;
  }

  .index__note a {
    text-decoration: underline;
  }
</style>
